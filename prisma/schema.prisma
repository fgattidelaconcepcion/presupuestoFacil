generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id               String    @id @default(cuid())
  name             String
  description      String?
  budget           Float
  budgetRemaining  Float
  status           String    @default("active")
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees        Employee[]
  payrolls         Payroll[]
  expenses         Expense[]
  materialOrders   MaterialOrder[]
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Employee {
  id           String       @id @default(cuid())
  name         String
  dailyRate    Float        @default(0)
  paymentType  String       @default("daily")
  sqmRate      Float?
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendances  Attendance[]
  payments     Payment[]
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model Payroll {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  weekEnd     DateTime
  totalPaid   Float        @default(0)
  status      String       @default("open")
  attendances Attendance[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
}

model Attendance {
  id           String   @id @default(cuid())
  payrollId    String
  payroll      Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day          String
  present      Boolean  @default(false)
  metersWorked Float?

  @@unique([payrollId, employeeId, day])
}

model Payment {
  id         String   @id @default(cuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  daysWorked Int
  metersTotal Float   @default(0)
  amount     Float
  createdAt  DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model MaterialOrder {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  supplier   String?
  notes      String?
  orderDate  DateTime        @default(now())
  status     String          @default("pending") // pending | partial | complete
  items      MaterialItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model MaterialItem {
  id               String        @id @default(cuid())
  orderId          String
  order            MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name             String
  unit             String        @default("un")
  quantityOrdered  Float         @default(1)
  quantityReceived Float         @default(0)
  received         Boolean       @default(false)
  receivedAt       DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}
